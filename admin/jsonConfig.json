{
    "i18n": true,
    "type": "panel",
    "items": {
        "holidayHeading": {
            "type": "header",
            "text": "Holiday Calendar Settings",
            "size": 4
        },
        "holidayInfoText": {
            "type": "staticText",
            "label": "Here you can configure the settings for the holiday calendar of the alarm clock.",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "holidayInstance": {
            "type": "instance",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 3,
            "label": "Select the holidays instance",
            "adapter": "feiertage",
            "tooltip": "Select the instance that contains the holiday data.",
            "default": ""
        },
        "publicHolidaysInstance": {
            "type": "instance",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 3,
            "label": "Select the public-holidays instance",
            "adapter": "public-holidays",
            "tooltip": "Select the instance that contains the holiday data.",
            "default": ""
        },
        "vacationHeading": {
            "type": "header",
            "text": "Vacation Calendar Settings",
            "size": 4
        },
        "vacationInfoText": {
            "type": "staticText",
            "label": "Here you can configure the settings for the vacation calendar of the alarm clock.",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "vacationInstance": {
            "type": "instance",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 3,
            "label": "Select the iCal instance",
            "adapter": "ical",
            "tooltip": "Select the instance that contains the vacation calendar data.",
            "default": ""
        },
        "vacationEvents": {
            "type": "table",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 10,
            "lg": 7,
            "xl": 7,
            "label": "The name of the appointment to be checked",
            "noDelete": false,
            "items": [
                {
                    "type": "text",
                    "attr": "name",
                    "title": "Appointment name (e.g., 'Vacation' or 'Late shift')",
                    "width": "85%"
                },
                {
                    "type": "checkbox",
                    "attr": "enabled",
                    "title": "Active?",
                    "width": "15%",
                    "default": true
                }
            ],
            "default": []
        },
        "appointmentHeading": {
            "type": "header",
            "text": "Appointment Calendar Settings",
            "size": 4
        },
        "appointmentInfoText": {
            "type": "staticText",
            "label": "Here you can configure the settings for the appointment calendar of the alarm clock.",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "appointmentInstance": {
            "type": "instance",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 3,
            "label": "Select the iCal instance",
            "adapter": "ical",
            "tooltip": "Select the instance that contains the wake-up times.",
            "default": ""
        },
        "appointmentEvents": {
            "type": "table",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 10,
            "lg": 7,
            "xl": 7,
            "label": "The name of the appointment to be checked",
            "noDelete": false,
            "items": [
                {
                    "type": "text",
                    "attr": "name",
                    "title": "Event name (e.g., 'alarm' or 'alert')",
                    "width": "85%"
                },
                {
                    "type": "checkbox",
                    "attr": "enabled",
                    "title": "Active?",
                    "width": "15%",
                    "default": true
                }
            ],
            "default": []
        },
        "mqttHeading": {
            "type": "header",
            "text": "MQTT-Broker Settings",
            "size": 4
        },
        "mqttInfoText": {
            "type": "staticText",
            "label": "Here you can configure the settings for the MQTT of the alarm clock.",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "mqttInstance": {
            "type": "instance",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 3,
            "label": "Select the MQTT instance",
            "adapter": "mqtt",
            "tooltip": "Select the instance that publish the MQTT data.",
            "default": ""
        },
        "mqttTopic": {
            "type": "text",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 3,
            "label": "The mqtt-publish Topic",
            "tooltip": "Input the Topic for the publish the values",
            "default": ""
        },
        "otherHeading": {
            "type": "header",
            "text": "Other settings",
            "size": 4
        },
        "otherInfoText": {
            "type": "staticText",
            "label": "Here you can configure other settings for the alarm clock.",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "maxWakeDelayHistory": {
            "type": "number",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 4,
            "xl": 3,
            "label": "Progression of wake-up delays",
            "tooltip": "Maximum number of entries in the wake-up delay history",
            "min": 7,
            "max": 3650,
            "step": 1
        }
    }
}
